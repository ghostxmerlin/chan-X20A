<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.stackchan.collector" android:versionCode="17" android:versionName="0.4.7">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="StackChan 观察台" android:theme="@style/AppTheme" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:usesCleartextTraffic="true" android:debuggable="true">
